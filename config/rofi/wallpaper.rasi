// =============================================================================
// wallpaper.rasi - rofi theme for the wallpaper switcher
// Inherits the launcher palette but uses a wider grid layout so wallpaper
// filenames are readable. Icons are disabled - the script passes names only.
// Invoke via: ~/.config/rofi/scripts/wallpaper.sh
// ===========================================================================

@import "launcher.rasi"

// Override window size for wallpaper picker
window {
    width:    680px;
    y-offset: -40px;
}

// Two-column grid so more names fit
listview {
    columns: 2;
    lines:   7;
    spacing: 6px;
}

// Slightly larger entry padding
inputbar {
    padding: 10px 16px;
}
