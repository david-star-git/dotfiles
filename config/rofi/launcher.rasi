// =============================================================================
// launcher.rasi - rofi theme
// Palette: config/theme/colors/palette.toml (Apple Dark Mode, green accent).
// Used for: app launcher (-show drun), wallpaper picker, any other rofi mode.
// To invoke:
// rofi -show drun -no-default-config -config ~/.config/rofi/launcher.rasi
// ===========================================================================

@import "../theme/colors/colors.rasi"

* {
    // The launcher window is more translucent than other rofi modes.
    base: #1a1a1c66;
}


// - Window ----------------------------------
window {
    transparency:       "real";
    background-color:   @base;
    border:             2px solid;
    border-color:       @crimson;
    border-radius:      14px;
    padding:            0px;
    width:              560px;
    // Vertical centering - appear slightly above screen center
    location:           center;
    anchor:             center;
    x-offset:           0;
    y-offset:           -60px;
}

// - Main box ---------------------------------
mainbox {
    background-color: transparent;
    children:         [ inputbar, message, listview ];
    spacing:          0px;
    padding:          12px;
}

// - Input bar --------------------------------
inputbar {
    background-color: @surface0;
    border-radius:    10px;
    padding:          10px 14px;
    spacing:          8px;
    margin:           0px 0px 10px 0px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @crimson;
    font:             "SF Pro Display Bold 13";
    vertical-align:   0.5;
}

entry {
    background-color:  transparent;
    text-color:        @text;
    font:              "SF Pro Display 13";
    placeholder:       "Search...";
    placeholder-color: @overlay0;
    vertical-align:    0.5;
    cursor:            text;
}

// - List view --------------------------------
listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    spacing:          4px;
    scrollbar:        false;
    fixed-height:     true;
    dynamic:          true;
}

// - Elements ---------------------------------
element {
    background-color: transparent;
    border-radius:    8px;
    padding:          8px 12px;
    spacing:          10px;
    orientation:      horizontal;
    children:         [ element-icon, element-text ];
}

element.normal.normal {
    background-color: transparent;
    text-color:       @subtext0;
}

element.normal.urgent {
    background-color: transparent;
    text-color:       @red;
}

element.normal.active {
    background-color: @surface0;
    text-color:       @text;
}

// Hovered
element.selected.normal {
    background-color: @surface0;
    text-color:       @text;
    border:           1px solid;
    border-color:     @crimson-dim;
    border-radius:    8px;
}

element.selected.urgent {
    background-color: @surface0;
    text-color:       @red;
}

element.selected.active {
    background-color: @surface1;
    text-color:       @text;
}

element-icon {
    background-color: transparent;
    size:             24px;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    font:             "SF Pro Display 13";
    vertical-align:   0.5;
    highlight:        bold;
    text-color:       @crimson;
}

// - Message (shown on no results) ----------------------
message {
    background-color: transparent;
    margin:           0px 0px 8px 0px;
}

textbox {
    background-color: transparent;
    text-color:       @overlay0;
    font:             "SF Pro Display 12";
    padding:          4px 12px;
}

// - Scrollbar (hidden above, kept here for completeness) -----------
scrollbar {
    background-color: @surface0;
    handle-color:     @crimson-dim;
    handle-width:     4px;
    border-radius:    4px;
    width:            6px;
}
