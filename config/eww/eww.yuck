;; Custom Scripts

(deflisten windows "./scripts/bin/hyprland-activewindow _")

;; System info (CLI)

(defpoll wifi_name :interval "1s" "nmcli -t -f name connection show --active | head -1")
(defpoll wifi_state :interval "3s" "scripts/wifi-reconcile.sh")
(defpoll bt_state :interval "3s" "scripts/bluetooth-reconcile.sh")
(defpoll bt_status :interval "3s" "scripts/bluetooth-status.sh")
(defpoll hotspot_state :interval "3s" "scripts/hotspot-reconcile.sh")
(defpoll hotspot_status :interval "3s" "scripts/hotspot-status.sh")
(defpoll wifi_strength :interval "1s" "nmcli -f IN-USE,SIGNAL device wifi | awk '/^\*/{if (NR!=1) {print $2}}'")
(defpoll hour :interval "1s" "date '+%a %b %_d %_H:%M'")

;; Notifications (DND), Tor, Airplane — the toggle/reconcile scripts already
;; write to dnd_state / airplane_state / tor_status via `eww update`; these
;; polls are what actually keep them live (and self-heal on drift), same
;; role the -reconcile.sh scripts play for wifi/bt/hotspot above.
(defpoll dnd_state :interval "3s" "scripts/dnd-reconcile.sh")
(defpoll airplane_state :interval "3s" "scripts/airplane-reconcile.sh")
(defpoll tor_status :interval "5s" "scripts/tor-status.sh")

(defpoll brightness :interval "1s" "brightnessctl g")
(defpoll max_brightness :interval "1s" "brightnessctl m")

(defpoll volume :interval "1s" "pamixer --get-volume")
(defpoll battery_name :interval "30s" "upower -e 2>/dev/null | grep -o 'BAT[0-9]*' | head -1")

;; State

(defvar control_center_open false)

;; Control-center page navigation. "main" is the default view; each
;; detail view (currently just "wifi") is its own named state — see the
;; sliding pages structure in control_center.yuck.
(defvar cc_view "main")

;; Wi-Fi detail view state
(defvar wifi_connecting_ssid "")
(defvar wifi_pw_value "")
(defvar wifi_pw_visible false)
(defvar wifi_connect_status "")
(defvar wifi_scanning false)
(defpoll wifi_networks :interval "10s" "scripts/wifi-scan.sh")

;; Bluetooth detail view state. bluetooth-scan.sh pushes bluetooth_nearby
;; directly (see the script) and returns the paired list as its own
;; stdout, captured here — one scan burst drives both lists.
(defvar bluetooth_nearby "[]")
(defvar bluetooth_scanning false)
(defpoll bluetooth_paired :interval "15s" "scripts/bluetooth-scan.sh")

;; Hotspot detail view state. ssid/password values are loaded once when
;; the view opens (scripts/hotspot-load-config.sh, chained into the
;; tile's onclick — see tile-row's detail-onclick) rather than polled,
;; so a background refresh never overwrites what you're mid-typing.
(defvar hotspot_ssid_value "Hotspot")
(defvar hotspot_password_value "")
(defvar hotspot_pw_visible false)
(defvar hotspot_configure_status "")
(defvar hotspot_scanning false)
(defpoll hotspot_clients :interval "5s" "scripts/hotspot-clients.sh")

;; Imports

(include "./control_center.yuck")

(defwindow panel
    :monitor 0
    :exclusive true
    :geometry (geometry :width "100%" :anchor "top center")
    :stacking "fg"
    :reserve (struts :distance "40px" :side "top")
    :windowtype "dock"
    :wm-ignore false
    :class "dark"
    (box
        :space-evenly false
        :class "container"
        (box :space-evenly false :hexpand true :class "section-container"
            (button :class "section selectable logo-button"
                :onclick "rofi -show drun -no-default-config -config ~/.config/rofi/launchpad.rasi"
                (image :image-width 15 :path "/usr/share/icons/WhiteSur/status/symbolic/nerds-logo-symbolic.svg")
            )
            (box :class "section selectable activetitle"
                "${windows[0].title}"
            )
        )
        (box :space-evenly false :class "section-container"
            (tray)
            (box
                :class "section"
                :space-evenly false
                (button
                    :class "selectable"
                    hour
                )
            )
        )
    )
)

(defwidget tray[]
    (box
        :class "section"
        (button
            :class "selectable"
            :onclick "eww update control_center_open='${!control_center_open}' cc_view='main' wifi_connecting_ssid='' wifi_pw_value='' wifi_pw_visible=false wifi_connect_status=''"
            (box :spacing 21 :space-evenly false
                (image
                    :tooltip "${volume}%"
                    :path "/usr/share/icons/WhiteSur/status/symbolic/audio-volume-${volume > 100 ? "overamplified" : volume > 66 ? "high" : volume > 33 ? "medium" : volume > 0 ? "low" : "muted"}-symbolic.svg"
                )
                (image
                    :tooltip {wifi_state == "1" ? (wifi_strength + "%") : "Off"}
                    :path "/usr/share/icons/WhiteSur/status/symbolic/${wifi_state != "1" ? "network-wireless-disabled" : "network-wireless-signal-" + (wifi_strength == "" ? "none" : wifi_strength > 66 ? "excellent" : wifi_strength > 33 ? "ok" : "weak")}-symbolic.svg")
                (image
                    :tooltip {bt_state == "1" ? bt_status : "Off"}
                    :path "/usr/share/icons/WhiteSur/status/symbolic/bluetooth-${bt_state == "1" ? "active" : "disabled"}-symbolic.svg"
                )
                (box :space-evenly false :spacing 8
                    (image
                        :path "/usr/share/icons/WhiteSur/status/symbolic/battery-level-${round(EWW_BATTERY[battery_name]["capacity"] / 10, 0) * 10}-${EWW_BATTERY[battery_name]["status"] == "Charging" ? "charging-" : ""}symbolic.svg"
                    )
                    "${EWW_BATTERY[battery_name]["capacity"]}%"
                )
            )
        )
    )
)
