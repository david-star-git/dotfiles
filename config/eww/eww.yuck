;; =============================================================================
;; eww.yuck — Quick Settings + Notification Center
;;
;; Two popovers opened from the waybar top bar, in the spirit of macOS's
;; Control Center (click the quick-settings icon) and Notification Center
;; (click the clock). Palette comes from config/theme/colors/palette.toml —
;; see eww.scss, which pulls in the same values.
;;
;; All data comes from small scripts in scripts/, each printing one plain
;; value (no JSON parsing inside yuck — keeps this file simple and robust
;; across eww versions). Toggles call a script directly; sliders call a
;; "-set.sh <value>" script via :onchange.
;; =============================================================================

;; ── Live data ────────────────────────────────────────────────────────────────
(defpoll wifi_enabled     :interval "5s"  "scripts/wifi-enabled.sh")
(defpoll wifi_ssid        :interval "5s"  "scripts/wifi-ssid.sh")
(defpoll bt_enabled       :interval "5s"  "scripts/bluetooth-enabled.sh")
(defpoll bt_status        :interval "5s"  "scripts/bluetooth-status.sh")
(defpoll volume_pct       :interval "2s"  "scripts/volume-get.sh")
(defpoll brightness_pct   :interval "2s"  "scripts/brightness-get.sh")
(defpoll power_profile    :interval "5s"  "scripts/power-profile-get.sh")
(defpoll battery_summary  :interval "30s" "scripts/battery-info.sh")
(defpoll dnd_mode         :interval "5s"  "cat ~/.cache/dnd-mode 2>/dev/null || echo off")
(defpoll tor_status       :interval "10s" "scripts/tor-status.sh")

;; ── Network panel data (separate window, see below) ──────────────────────────
(defpoll wifi_networks       :interval "15s" "scripts/wifi-scan.sh")
(defpoll wifi_failed_ssid    :interval "1s"  "cat ~/.cache/wifi-connect-failed-ssid 2>/dev/null || true")
(defpoll bt_devices          :interval "15s" "scripts/bluetooth-scan.sh")
(defvar wifi_password_input "")

;; ── Quick Settings window ────────────────────────────────────────────────────
;; Opened by waybar's custom/quick-settings module.
(defwindow quick-settings
  :monitor 0
  :geometry (geometry :x "12px" :y "6px" :width "300px" :height "0px" :anchor "top right")
  :stacking "overlay"
  :exclusive false
  :focusable true
  (quick-settings-panel))

(defwidget quick-settings-panel []
  (box :class "qs-panel" :orientation "v" :space-evenly false :spacing 14
    (box :class "qs-tiles" :orientation "h" :space-evenly true :spacing 8
      (qs-tile :label "Wi-Fi"
               :on {wifi_enabled == "1"}
               :purple false
               :sublabel {wifi_ssid}
               :onclick "scripts/wifi-toggle.sh")
      (qs-tile :label "Bluetooth"
               :on {bt_enabled == "1"}
               :purple false
               :sublabel {bt_status}
               :onclick "scripts/bluetooth-toggle.sh")
      (qs-tile :label "Do Not Disturb"
               :on {dnd_mode != "off"}
               :purple false
               :sublabel {dnd_mode == "off" ? "Off" : "On"}
               :onclick "~/.config/hypr/scripts/dnd.py --toggle; pkill -SIGRTMIN+4 waybar"))

    (box :class "qs-tiles" :orientation "h" :space-evenly true :spacing 8
      (qs-tile :label "Power Profile"
               :on {power_profile != "power-saver"}
               :purple false
               :sublabel {power_profile}
               :onclick "scripts/power-profile-cycle.sh")
      (qs-tile :label "Tor"
               :on {tor_status != "off"}
               :purple {tor_status == "connected"}
               :sublabel {tor_status == "off" ? "Off" : tor_status == "connecting" ? "Connecting…" : "Connected"}
               :onclick {tor_status == "off" ? "~/.scripts/tor/tor-toggle.sh on" : "~/.scripts/tor/tor-toggle.sh off"}))

    (box :class "qs-slider-row" :orientation "h" :space-evenly false :spacing 8
      (label :class "qs-slider-icon" :text "󰃟")
      (scale :class "qs-slider"
             :value brightness_pct
             :min 1 :max 100
             :onchange "scripts/brightness-set.sh {}"))

    (box :class "qs-slider-row" :orientation "h" :space-evenly false :spacing 8
      (label :class "qs-slider-icon" :text "󰕾")
      (scale :class "qs-slider"
             :value volume_pct
             :min 0 :max 100
             :onchange "scripts/volume-set.sh {}"))

    (box :class "qs-footer" :orientation "h" :space-evenly false :spacing 6
      (label :class "qs-battery" :text {battery_summary} :halign "start" :hexpand true)
      (button :class "qs-link" :onclick "eww open --toggle network-panel"    "Network")
      (button :class "qs-link" :onclick "eww open --toggle bluetooth-panel"  "Bluetooth")
      (button :class "qs-link" :onclick "~/.config/hypr/scripts/launch-audio.py" "Sound"))))

;; A single toggle tile: icon-less, label + sublabel, highlighted green when
;; on, or purple instead when :purple is true (Tor's verified-connected state
;; — purple always means "verified", never just "toggled on").
(defwidget qs-tile [label sublabel on onclick purple]
  (eventbox :onclick onclick
    (box :class "qs-tile ${purple ? "qs-tile-purple" : on ? "qs-tile-on" : ""}" :orientation "v" :space-evenly false :spacing 2
      (label :class "qs-tile-label" :text label :halign "start")
      (label :class "qs-tile-sublabel" :text sublabel :halign "start" :limit-width 14))))

;; ── Notification Center window (calendar) ────────────────────────────────────
;; Opened by waybar's clock module. A real notification history needs
;; swaync in place of mako — this popover is the calendar half only; see
;; the summary this shipped with for that trade-off.
(defwindow notification-center
  :monitor 0
  :geometry (geometry :x "12px" :y "6px" :width "300px" :height "0px" :anchor "top right")
  :stacking "overlay"
  :exclusive false
  :focusable true
  (notification-center-panel))

(defwidget notification-center-panel []
  (box :class "nc-panel" :orientation "v" :space-evenly false :spacing 8
    (label :class "nc-heading" :text {formattime(EWW_TIME, "%A, %B %e")} :halign "start")
    (label :class "nc-clock" :text {formattime(EWW_TIME, "%H:%M")} :halign "start")))

;; ── Network panel window (Wi-Fi scan + connect) ──────────────────────────────
;; Opened by waybar's network module, or the "Network" button in Quick
;; Settings. Click a network to connect — if it needs a password nmcli
;; doesn't already have saved, the attempt fails and a password field opens
;; for that specific tile.
;; Known limitation: a password containing a single-quote won't pass through
;; the shell command built here correctly — retype without it if that happens.
(defwindow network-panel
  :monitor 0
  :geometry (geometry :x "12px" :y "6px" :width "320px" :height "0px" :anchor "top right")
  :stacking "overlay"
  :exclusive false
  :focusable true
  (network-panel-widget))

(defwidget network-panel-widget []
  (box :class "net-panel" :orientation "v" :space-evenly false :spacing 8
    (box :orientation "h" :space-evenly false :spacing 6
      (label :text "Wi-Fi" :class "net-panel-heading" :halign "start" :hexpand true)
      (button :class "qs-link" :onclick "eww poll wifi_networks" "Refresh"))
    (scroll :height 280 :hscroll false
      (box :orientation "v" :space-evenly false :spacing 4
        (for network in wifi_networks
          (wifi-tile :ssid {network.ssid}
                     :signal {network.signal}
                     :secured {network.secured}
                     :active {network.active}))))))

(defwidget wifi-tile [ssid signal secured active]
  (box :orientation "v" :space-evenly false :spacing 2 :class "net-tile"
    (eventbox :onclick "scripts/wifi-connect.sh '${ssid}'"
      (box :orientation "h" :space-evenly false :spacing 8 :class "net-tile-row ${active ? "net-tile-active" : ""}"
        (label :text {secured ? "󰤪" : "󰤨"} :class "net-tile-icon")
        (label :text ssid :halign "start" :hexpand true :limit-width 20 :class "net-tile-label")
        (label :text "${signal}%" :class "net-tile-signal")))
    (revealer :reveal {wifi_failed_ssid == ssid} :transition "slidedown" :duration "150ms"
      (box :orientation "h" :space-evenly false :spacing 4 :class "net-tile-password-row"
        (input :class "net-tile-password-input" :value wifi_password_input :password true
               :onchange "eww update wifi_password_input={}")
        (button :class "qs-link" :onclick "scripts/wifi-connect.sh '${ssid}' '${wifi_password_input}'" "Connect")))))

;; ── Bluetooth panel window (scan + pair/connect) ─────────────────────────────
;; Some devices need interactive PIN/passkey confirmation bluetoothctl can't
;; answer non-interactively — those will fail here; most audio/keyboard
;; "just works" devices pair fine.
(defwindow bluetooth-panel
  :monitor 0
  :geometry (geometry :x "12px" :y "6px" :width "320px" :height "0px" :anchor "top right")
  :stacking "overlay"
  :exclusive false
  :focusable true
  (bluetooth-panel-widget))

(defwidget bluetooth-panel-widget []
  (box :class "net-panel" :orientation "v" :space-evenly false :spacing 8
    (box :orientation "h" :space-evenly false :spacing 6
      (label :text "Bluetooth" :class "net-panel-heading" :halign "start" :hexpand true)
      (button :class "qs-link" :onclick "eww poll bt_devices" "Scan"))
    (scroll :height 280 :hscroll false
      (box :orientation "v" :space-evenly false :spacing 4
        (for device in bt_devices
          (bt-tile :mac {device.mac}
                   :name {device.name}
                   :paired {device.paired}
                   :connected {device.connected}))))))

(defwidget bt-tile [mac name paired connected]
  (eventbox :onclick "scripts/bluetooth-connect.sh '${mac}'"
    (box :orientation "h" :space-evenly false :spacing 8 :class "net-tile-row ${connected ? "net-tile-active" : ""}"
      (label :text {connected ? "󰂱" : (paired ? "󰂯" : "󰂲")} :class "net-tile-icon")
      (label :text name :halign "start" :hexpand true :limit-width 20 :class "net-tile-label")
      (label :text {connected ? "Connected" : (paired ? "Paired" : "")} :class "net-tile-signal"))))
