(defwindow control_center
    :monitor 0
    :exclusive false
    :geometry (geometry :width "460px" :y "-16px" :x "32px" :anchor "top right")
    :stacking "fg"
    :wm-ignore false
    :class "dark"
    (revealer :reveal control_center_open :transition "none"
        (eventbox :onhoverlost "eww update control_center_open='false'"
        (box :class "container" :space-evenly false :spacing 16 :orientation "vertical"
            (box :spacing 16
                (quick_settings)
                (quick_settings_secondary)
            )
            (box
                :class "slider control"
                :orientation "vertical"
                :space-evenly false
                :spacing 8
                (label :xalign 0 :text "Display")
                (scale :class "scale" :value brightness :min 0 :max max_brightness
                       :onchange "brightnessctl s {} && echo {} > ~/.cache/saved-brightness")
            )
            (box
                :class "slider control"
                :orientation "vertical"
                :space-evenly false
                :spacing 8
                (label :xalign 0 :text "Sound")
                (scale :class "scale" :value volume :min 0 :max 100
                       :onchange "pamixer --set-volume {} && eww update volume='{}' && echo {} > ~/.cache/saved-volume")
            )
        )
        )
    )
)

;; A single Control-Center-style row: a clickable icon circle (toggles the
;; feature) plus an inert label/sublabel next to it. Only the circle is
;; clickable for now — the text becomes a way into a detail panel later.
(defwidget tile-row [icon label sublabel enabled onclick icon-class]
    (box :space-evenly false :spacing 12
        (eventbox :onclick onclick :class "icon-hitbox" :cursor "pointer"
            (box :class "icon ${enabled ? "icon-on" : ""} ${icon-class}" :valign "center"
                (image :image-width 21 :path "/usr/share/icons/WhiteSur-dark/status/symbolic/${icon}-symbolic.svg")
            )
        )
        (box :orientation "vertical"
            (label :xalign 0 :text label)
            (label :xalign 0 :class "muted" :text sublabel)
        )
    )
)

(defwidget quick_settings[]
    (box :class "control" :orientation "vertical" :spacing 16
        (tile-row :icon {wifi_state == "1" ? "network-wireless-signal-excellent" : "network-wireless-disabled"}
                  :label "Wi-Fi"
                  :enabled {wifi_state == "1"}
                  :icon-class ""
                  :sublabel {wifi_state != "1" ? "Off" : strlength(wifi_name) > 13 ? captures(wifi_name, '.{0,12}')[0][0] + "..." : wifi_name}
                  :onclick "scripts/wifi-toggle.sh")
        (tile-row :icon {bt_state == "1" ? "bluetooth-active" : "bluetooth-disabled"}
                  :label "Bluetooth"
                  :enabled {bt_state == "1"}
                  :icon-class ""
                  :sublabel bt_status
                  :onclick "scripts/bluetooth-toggle.sh")
        (tile-row :icon "network-wireless-hotspot"
                  :label "Hotspot"
                  :enabled {hotspot_state == "1"}
                  :icon-class ""
                  :sublabel hotspot_status
                  :onclick "scripts/hotspot-toggle.sh")
    )
)

;; Second column: Notifications (DND), Tor, Airplane. Same tile-row as the
;; block above — wired to the vars/scripts that were already sitting in
;; scripts/ unused (dnd_state, tor_status, airplane_state).
(defwidget quick_settings_secondary[]
    (box :class "control" :orientation "vertical" :spacing 16
        (tile-row :icon {dnd_state == "on" ? "notification-disabled" : "notification-active"}
                  :label "Notifications"
                  :enabled {dnd_state == "on"}
                  :icon-class ""
                  :sublabel {dnd_state == "on" ? "Do Not Disturb" : "On"}
                  :onclick "scripts/dnd-toggle.sh")
        (tile-row :icon {tor_status == "off" ? "network-vpn-disabled" : "network-vpn"}
                  :label "Tor"
                  :enabled false
                  :icon-class {tor_status == "connected" ? "icon-tor-connected" : tor_status == "connecting" ? "icon-tor-connecting" : ""}
                  :sublabel {tor_status == "connected" ? "Connected" : tor_status == "connecting" ? "Connecting…" : "Off"}
                  :onclick "scripts/tor-click.sh")
        (tile-row :icon {airplane_state == "1" ? "airplane-mode" : "airplane-mode-disabled"}
                  :label "Airplane"
                  :enabled {airplane_state == "1"}
                  :icon-class ""
                  :sublabel {airplane_state == "1" ? "On" : "Off"}
                  :onclick "scripts/airplane-toggle.sh")
    )
)
