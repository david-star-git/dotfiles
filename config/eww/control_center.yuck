(defwindow control_center
    :monitor 0
    :exclusive false
    :geometry (geometry :width "460px" :y "-16px" :x "32px" :anchor "top right")
    :stacking "fg"
    :wm-ignore false
    :class "dark"
    (revealer :reveal control_center_open :transition "none"
        (eventbox :onhoverlost "eww update control_center_open='false'"
        (box :class "container" :space-evenly false :spacing 16 :orientation "vertical"
            (box :spacing 16
                (quick_settings)
                (box :class "control")
            )
            (box
                :class "slider control"
                :orientation "vertical"
                :space-evenly false
                :spacing 8
                (label :xalign 0 :text "Display")
                (scale :class "scale" :value brightness :min 0 :max max_brightness
                       :onchange "brightnessctl s {} && echo {} > ~/.cache/saved-brightness")
            )
            (box
                :class "slider control"
                :orientation "vertical"
                :space-evenly false
                :spacing 8
                (label :xalign 0 :text "Sound")
                (scale :class "scale" :value volume :min 0 :max 100
                       :onchange "pamixer --set-volume {} && eww update volume='{}' && echo {} > ~/.cache/saved-volume")
            )
        )
        )
    )
)

;; A single Control-Center-style row: a clickable icon circle (toggles the
;; feature) plus an inert label/sublabel next to it. Only the circle is
;; clickable for now — the text becomes a way into a detail panel later.
(defwidget tile-row [icon label sublabel enabled onclick]
    (box :space-evenly false :spacing 12
        (eventbox :onclick onclick
            (box :class "icon ${enabled ? "icon-on" : ""}" :valign "center"
                (image :image-width 21 :path "/usr/share/icons/WhiteSur-dark/status/symbolic/${icon}-symbolic.svg")
            )
        )
        (box :orientation "vertical"
            (label :xalign 0 :text label)
            (label :xalign 0 :class "muted" :text sublabel)
        )
    )
)

(defwidget quick_settings[]
    (box :class "control" :orientation "vertical" :spacing 16
        (tile-row :icon {wifi_enabled == "1" ? "network-wireless-signal-excellent" : "network-wireless-disabled"}
                  :label "Wi-Fi"
                  :enabled {wifi_enabled == "1"}
                  :sublabel {wifi_enabled != "1" ? "Off" : strlength(wifi_name) > 13 ? captures(wifi_name, '.{0,12}')[0][0] + "..." : wifi_name}
                  :onclick "scripts/wifi-toggle.sh")
        (tile-row :icon {bt_enabled == "1" ? "bluetooth-active" : "bluetooth-disabled"}
                  :label "Bluetooth"
                  :enabled {bt_enabled == "1"}
                  :sublabel bt_status
                  :onclick "scripts/bluetooth-toggle.sh")
        (tile-row :icon "network-wireless-hotspot"
                  :label "Hotspot"
                  :enabled {hotspot_enabled == "1"}
                  :sublabel hotspot_status
                  :onclick "scripts/hotspot-toggle.sh")
    )
)
