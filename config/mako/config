# ~/.config/mako/config

# ── Layout ────────────────────────────────────────────────────────────────────
anchor=top-right
layer=overlay
max-visible=5
sort=-time

margin=8
padding=12,14
width=320
height=120
border-size=2
border-radius=5

# ── Typography ────────────────────────────────────────────────────────────────
font=monospace 10

# ── Colors (default / normal urgency) ────────────────────────────────────────
background-color=#131315e6
border-color=#30d158
text-color=#e5e5e7
progress-color=over #30d158

# ── Behaviour ─────────────────────────────────────────────────────────────────
default-timeout=6000
ignore-timeout=0
group-by=app-name
format=<b>%s</b>\n%b

# ── Urgency: normal ───────────────────────────────────────────────────────────
[urgency=normal]
background-color=#131315e6
border-color=#30d158
text-color=#e5e5e7
default-timeout=6000

# ── Urgency: low ─────────────────────────────────────────────────────────────
[urgency=low]
background-color=#131315e6
border-color=#511919
text-color=#a1a1a6
default-timeout=4000

# ── Urgency: critical ────────────────────────────────────────────────────────
[urgency=critical]
background-color=#1a1a1c
border-color=#ff453a
text-color=#e5e5e7
default-timeout=0

# ── DND mode: hide everything except critical ─────────────────────────────────
[mode=dnd urgency=low]
invisible=1

[mode=dnd urgency=normal]
invisible=1

# ── Ultra mode: hide absolutely everything ────────────────────────────────────
[mode=ultra urgency=low]
invisible=1

[mode=ultra urgency=normal]
invisible=1

[mode=ultra urgency=critical]
invisible=1
