font=SF Pro Display 11
background-color=#1c1c1ccc
text-color=#f5f5f7

width=360
height=110

padding=16
margin=12

border-size=1
border-color=#ffffff18
border-radius=16

# ── Position ────────────────────────────────────────

anchor=top-right

# ── Icons ───────────────────────────────────────────

icons=1
max-icon-size=48

# ── Behaviour ───────────────────────────────────────

default-timeout=5000
ignore-timeout=0
max-visible=5
sort=-time

# ── Text ────────────────────────────────────────────

markup=1
actions=1

format=<b>%s</b>\n%b

# ── Progress bars ───────────────────────────────────

progress-color=over #ffffff30


# ── Urgency ─────────────────────────────────────────

[urgency=low]
background-color=#1c1c1ccc
text-color=#b8b8bd
border-color=#ffffff12

[urgency=normal]
background-color=#1c1c1ccc
text-color=#f5f5f7
border-color=#ffffff18

[urgency=high]
background-color=#2a1c1ccc
text-color=#ffffff
border-color=#ff453a66
