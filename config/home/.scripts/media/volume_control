#!/usr/bin/env bash
# volume_control — adjust the default sink's volume by a relative step,
# clamped to a maximum percentage (lets media-key repeats overshoot past
# 100% for quiet headphones without blowing out normal speakers).
#
# Usage: volume_control -s +5 -m 125
#        volume_control -s -5 -m 125
set -euo pipefail

step=5
max=100

while [[ $# -gt 0 ]]; do
    case "$1" in
        -s) step="$2"; shift 2 ;;
        -m) max="$2"; shift 2 ;;
        *) shift ;;
    esac
done

current=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+(?=%)' | head -1)
target=$(( current + step ))
(( target < 0 ))   && target=0
(( target > max )) && target=$max

pactl set-sink-volume @DEFAULT_SINK@ "${target}%"
