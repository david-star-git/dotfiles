#!/usr/bin/env bash
# brightness_level — shows a mako progress notification with current brightness.
set -euo pipefail

pct=$(brightnessctl -m | cut -d, -f4 | tr -d '%')

if   (( pct < 34 ));  then icon="display-brightness-low"
elif (( pct < 67 ));  then icon="display-brightness-medium"
else                       icon="display-brightness-high"
fi

notify-send -a "brightness" -u low -i "$icon" \
    -h string:x-canonical-private-synchronous:brightness \
    -h int:value:"$pct" \
    "Brightness" "${pct}%"
